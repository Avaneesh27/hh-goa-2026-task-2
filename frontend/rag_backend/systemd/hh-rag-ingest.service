[Unit]
Description=HH Goa complete MSMARCO-XI resumable ingestion
After=hh-rag-api.service
Requires=hh-rag-api.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hh-goa-voice-rag/rag_backend
ExecStart=/usr/bin/docker compose --profile ingest run --rm ingest
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
