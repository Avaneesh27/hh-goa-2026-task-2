# =============================================================================
# Voice-Enabled RAG System (HH Goa 2026) Environment Configuration
# =============================================================================

# Dataset & Local RAG Training Configuration (AI4Bharat MSMARCO-XI)
# Zero external proprietary API keys required. Runs 100% locally on MSMARCO-XI dataset.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=local
LLM_BASE_URL=

# Speech-To-Text (Optional: Sarvam API for microphone transcription, or browser Web Speech)
SARVAM_API_KEY=your_sarvam_api_key_here

# Embedding & Reranker Models (Pre-downloaded or HuggingFace ID)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Qdrant Vector Database
USE_LOCAL_QDRANT_STORAGE=true
LOCAL_QDRANT_PATH=data/qdrant_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_hindi_english

# Local BM25 Path
BM25_INDEX_PATH=data/bm25_index.pkl

# Service URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
